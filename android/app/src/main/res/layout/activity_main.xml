<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textColor="#147D68" android:textSize="18sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="@string/stage_label" android:textColor="#64716B" android:textSize="12sp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/headline" android:textColor="#172F28" android:textSize="30sp" android:textStyle="bold" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:text="@string/subtitle" android:textColor="#64716B" android:textSize="14sp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:background="@drawable/card_background" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/remote_heading" android:textColor="#172F28" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:text="@string/remote_note" android:textColor="#64716B" android:textSize="13sp" />
            <TextView android:id="@+id/remote_state" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/remote_initial" android:textColor="#52625A" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/remote_start" style="@style/TestButton" android:layout_marginTop="12dp" android:text="@string/remote_start" />
            <Button android:id="@+id/remote_stop" style="@style/TestButton" android:text="@string/remote_stop"
                android:enabled="false" android:backgroundTint="#E9E7E1" android:textColor="#5C5147" />
            <TextView android:id="@+id/remote_records" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textColor="#64716B" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:background="@drawable/card_background" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/ble_heading" android:textColor="#172F28" android:textSize="18sp" android:textStyle="bold" />
            <TextView android:id="@+id/ble_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/ble_initial" android:textColor="#52625A" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp"
                android:text="@string/ble_note" android:textColor="#64716B" android:textSize="12sp" />
            <Button android:id="@+id/ble_scan" style="@style/TestButton" android:layout_marginTop="12dp" android:text="@string/ble_scan" />
            <LinearLayout android:id="@+id/ble_devices" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
            <Button android:id="@+id/ble_disconnect" style="@style/TestButton" android:text="@string/ble_disconnect" android:enabled="false" android:backgroundTint="#E9E7E1" android:textColor="#5C5147" />
            <TextView android:id="@+id/ble_latest" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp"
                android:text="@string/ble_no_events" android:textColor="#172F28" android:textSize="16sp" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/ble_clear" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minHeight="48dp" android:text="@string/ble_clear" android:textAllCaps="false" />
            <TextView android:id="@+id/ble_records" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#64716B" android:textSize="13sp" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:background="@drawable/card_background" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/status_heading" android:textColor="#172F28" android:textSize="16sp" android:textStyle="bold" />
            <TextView android:id="@+id/service_status" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:textColor="#64716B" android:textSize="14sp" android:accessibilityLiveRegion="polite" />
            <Button android:id="@+id/open_settings" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="48dp" android:layout_marginTop="8dp" android:text="@string/settings_button" android:textAllCaps="false"
                android:backgroundTint="#E0EEE6" android:textColor="#145C4C" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:text="@string/instructions" android:textColor="#52625A" android:textSize="13sp" android:lineSpacingExtra="5dp" />
        <Button android:id="@+id/swipe_up" style="@style/TestButton" android:layout_marginTop="20dp" android:text="@string/swipe_up" />
        <Button android:id="@+id/swipe_down" style="@style/TestButton" android:text="@string/swipe_down" />
        <Button android:id="@+id/tap" style="@style/TestButton" android:text="@string/tap" android:backgroundTint="#DDE8DF" android:textColor="#174D3C" />
        <Button android:id="@+id/cancel" style="@style/TestButton" android:text="@string/cancel" android:backgroundTint="#E9E7E1" android:textColor="#5C5147" android:enabled="false" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:background="@drawable/card_background" android:orientation="vertical" android:padding="18dp">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/result_heading" android:textColor="#172F28" android:textSize="14sp" android:textStyle="bold" />
            <TextView android:id="@+id/result" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="8dp" android:text="@string/initial_result" android:textColor="#52625A" android:textSize="14sp"
                android:accessibilityLiveRegion="polite" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="@string/privacy_note" android:textColor="#64716B" android:textSize="12sp" android:lineSpacingExtra="3dp" />
    </LinearLayout>
</ScrollView>

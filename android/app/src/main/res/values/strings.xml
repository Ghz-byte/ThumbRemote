<resources>
    <string name="app_name">ThumbRemote</string>
    <string name="service_name">ThumbRemote 手势控制</string>
    <string name="service_summary">执行手动测试或你主动开启会话中的上下滑遥控</string>
    <string name="service_description">手动测试由你点击按钮后倒计时执行；蓝牙遥控仅在你主动点击开始遥控后，把硬件上下滑即时转换为当前应用的屏幕滑动。左右不执行。不读取屏幕内容，不联网。你可从App、通知停止遥控，或在系统设置关闭本服务。</string>
    <string name="stage_label">阶段 03 · 蓝牙上下滑遥控</string>
    <string name="headline">用拇指\n切换下一条。</string>
    <string name="subtitle">先选择开发板，再主动开启遥控。</string>
    <string name="remote_heading">上下滑遥控</string>
    <string name="remote_note">先在下方扫描并选择开发板、开启辅助功能，再点开始。开启后可切换到抖音；硬件上下滑将立即作用于当前应用，左右只记录。通知可停止；锁屏或断线后需重新开启。</string>
    <string name="remote_initial">遥控未开启</string>
    <string name="remote_start">开始遥控</string>
    <string name="remote_stop">停止遥控</string>

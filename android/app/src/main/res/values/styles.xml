<resources>
    <style name="Base.Theme.ThumbRemote" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#147D68</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowBackground">#F6F5F0</item>
        <item name="android:statusBarColor">#F6F5F0</item>
        <item name="android:navigationBarColor">#172F28</item>
    </style>
    <style name="Theme.ThumbRemote" parent="Base.Theme.ThumbRemote" />
    <style name="TestButton" parent="android:style/Widget.Material.Button">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">60dp</item>
        <item name="android:layout_marginTop">10dp</item>
